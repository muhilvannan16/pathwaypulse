# Copy this file to ".env" (in this backend/ folder) and fill in your values.
# ".env" is git-ignored on purpose. NEVER commit it, paste it into chat,
# or copy these values into the frontend.
#
# !!! WARNING !!!
# The service key below has FULL access to your database and skips all
# row-level security. Treat it like a password.
#  - It belongs ONLY on the server (backend/.env, and the hosting provider's
#    environment-variable settings such as Render).
#  - Never put it in frontend code or in any variable starting with VITE_
#    (those are published to every visitor's browser).
#  - If it is ever exposed, rotate it in Supabase right away.

# Supabase dashboard -> Project Settings -> API -> Project URL
SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co

# Supabase dashboard -> Project Settings -> API -> the "service_role" key
# (newer projects may call it the "secret" key). NOT the anon/public key.
SUPABASE_SERVICE_KEY=replace-with-your-service-role-key

# Secret for the moderator tools (approve / reject reports). Make a long random
# one, for example by running:
#     python -c "import secrets; print(secrets.token_urlsafe(32))"
# Keep it ONLY here (backend/.env) and in Render's environment variables.
# Never commit it, paste it into chat, or put it in the frontend or any VITE_ variable.
# If it is left empty, the moderator endpoints refuse everyone.
MODERATOR_TOKEN=
