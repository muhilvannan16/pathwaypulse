# Copy this file to ".env.local" and change the values if you need to.
# Variables starting with VITE_ are visible in the browser, so NEVER put
# secrets (passwords, service keys) here.

# Where the FastAPI backend is running.
VITE_API_URL=http://localhost:8000

# "api"    = load and save reports through the backend (default)
# "sample" = use made-up local sample data, no backend needed
VITE_DATA_SOURCE=api
